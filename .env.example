# Dev-only API base for `npm run dev` (backend Docker container on :8080).
# Copy to .env for local development. NEVER needed on servers — production
# builds take the API URL from the compose build arg (FE_API_URL, default
# https://legal-analyzer.lintasarta.dev).
VITE_API_URL=http://localhost:8080

# Rollout escape hatch for the legacy two-panel login at /login/legacy.
# Default: enabled (any value except 0). Set to 0 and rebuild to hide the
# legacy route. Remove together with AuthLegacy.tsx after the rollout window.
VITE_LEGACY_LOGIN=1
